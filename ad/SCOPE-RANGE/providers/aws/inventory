[all:vars]
ansible_connection=amazon.aws.aws_ssm
ansible_aws_ssm_bucket_name=AUTO
ansible_aws_ssm_region={{region}}
ansible_aws_ssm_s3_addressing_style=virtual
ansible_aws_ssm_retries=5
ansible_aws_ssm_timeout=300
ansible_shell_type=sh
ansible_user=ssm-user
ansible_become=true
ansible_become_method=sudo
ansible_python_interpreter=/usr/bin/python3
env={{env}}
range_domain=range.test
range_dns_server=10.50.10.60
range_upstream_dns=10.50.0.2

[scope_range]
kali01 ansible_host=PENDING ansible_user=kali
web01 ansible_host=PENDING
data01 ansible_host=PENDING
dev01 ansible_host=PENDING
storage01 ansible_host=PENDING
services01 ansible_host=PENDING

[service_hosts]
web01
data01
dev01
storage01
services01

[attack_box]
kali01

[web]
web01

[data]
data01

[development]
dev01

[storage]
storage01

[infrastructure_services]
services01
